# Environment — copy to .env.local and adjust
# Use your computer's LAN IP during development (not localhost).
# Find it with: ipconfig  →  "IPv4 Address"
# Example: http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://192.168.1.89:3000

# Convex deployment shared with the website dashboard.
# Must match NEXT_PUBLIC_CONVEX_URL in the kitchen-landing project.
EXPO_PUBLIC_CONVEX_URL=https://agreeable-parakeet-735.eu-west-1.convex.cloud

# Admin secret used by the Convex functions in convex/records.ts.
# SECURITY: EXPO_PUBLIC_ values are embedded in the app bundle. Keep this build
# internal (TestFlight / direct APK). Move to a server proxy or Convex Auth
# before a public store release.
EXPO_PUBLIC_CONVEX_ADMIN_SECRET=

# Dev-only preview: skip the login screen while the backend auth endpoint
# is not deployed yet. Ignored in production builds.
# EXPO_PUBLIC_DEV_AUTH_BYPASS=true

# Public website used for client-facing share links.
EXPO_PUBLIC_PUBLIC_SITE_URL=https://www.faoudesign.com
